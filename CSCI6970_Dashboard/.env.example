# Frontend: leave NEXT_PUBLIC_API_URL unset to use same-origin /api proxy.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Used by Next.js rewrites (server-side only)
BACKEND_URL=http://127.0.0.1:8000

# Backend CORS (direct browser calls, if any)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production examples:
# BACKEND_URL=https://<user>-diabetesinsight-api.hf.space
# CORS_ORIGINS=https://diabetesinsight.vercel.app
# See docs/DEPLOY.md
